// Bishoftu Finance - Tax Collection Management System
// Prisma schema for PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon requires a connection pool size limit; directUrl is optional
  // directUrl = env("DIRECT_URL")
}

// ---- Master data -----------------------------------------------------------

// Sub-City (Kifle Ketema) — groups multiple woredas together.
// Hierarchy: City (Bishoftu) > Sub-City > Woreda
model SubCity {
  id        String   @id @default(cuid())
  name      String   @unique
  region    String?  // e.g. "Oromia"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  woredas       Woreda[]
  assignedStaff Staff[] @relation("StaffAssignedSubCity")
  teams         Team[]
  plans         Plan[]
}

// Woreda (sub-district) — belongs to a Sub-City.
model Woreda {
  id         String   @id @default(cuid())
  name       String   @unique
  region     String?  // e.g. "Oromia"
  subCityId  String?
  subCity    SubCity? @relation(fields: [subCityId], references: [id])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  taxPayers       TaxPayer[]
  targets         YearlyTaxTarget[]
  assignedStaff   Staff[] @relation("StaffAssignedWoreda")
  teams           Team[]
  plans           Plan[]
}

// Finance office staff members
// Roles: SYSTEM_ADMIN, CITY_ADMIN, SUBCITY_ADMIN, WOREDA_ADMIN,
//        LEADER, TEAM_1_ASSIGNMENT, TEAM_2_FINANCE, CITY_REVENUE_OFFICER,
//        DATA_COLLECTOR, TEAM_LEAD, TEAM_MEMBER
model Staff {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  phone         String?
  role          String   @default("TEAM_1_ASSIGNMENT")
  passwordHash  String?
  active        Boolean  @default(true)

  // Hierarchical scoping:
  // - CITY_ADMIN / SYSTEM_ADMIN / LEADER: both null (see everything)
  // - SUBCITY_ADMIN: assignedSubCityId set (see one sub-city + its woredas)
  // - WOREDA_ADMIN / DATA_COLLECTOR: assignedWoredaId set (see one woreda)
  // - TEAM_LEAD / TEAM_MEMBER: teamId set (see their team's data)
  assignedSubCityId String?
  assignedSubCity   SubCity? @relation("StaffAssignedSubCity", fields: [assignedSubCityId], references: [id])
  assignedWoredaId  String?
  assignedWoreda    Woreda?  @relation("StaffAssignedWoreda", fields: [assignedWoredaId], references: [id])
  teamId            String?
  team              Team?    @relation("TeamMembers", fields: [teamId], references: [id])

  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignmentsAssigned       TaxAssignment[] @relation("StaffAssignedTo")
  bankReceiptsReceivedBy    TaxAssignment[] @relation("StaffBankReceiptReceiver")
  governmentReceiptsIssuedBy TaxAssignment[] @relation("StaffGovtReceiptIssuer")
  history                   AssignmentHistory[]
  taxTargetsSet             YearlyTaxTarget[]
  ledTeams                  Team[] @relation("TeamLead")
  plansResponsible          Plan[] @relation("PlanResponsible")
  plansCreated              Plan[] @relation("PlanCreator")
  notificationsReceived     Notification[] @relation("NotificationsReceived")
}

// Team — organizational unit within a woreda (or sub-city)
model Team {
  id          String   @id @default(cuid())
  name        String   // e.g. "Team A - Business Tax Collectors"
  description String?
  woredaId    String?
  woreda      Woreda?  @relation(fields: [woredaId], references: [id])
  subCityId   String?
  subCity     SubCity? @relation(fields: [subCityId], references: [id])
  leadStaffId String?
  lead        Staff?   @relation("TeamLead", fields: [leadStaffId], references: [id])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     Staff[] @relation("TeamMembers")
  plans       Plan[]
}

// Collection Plan — supports daily/weekly/monthly/quarterly/annual planning
// at every administrative level (city, sub-city, woreda, team).
model Plan {
  id              String   @id @default(cuid())
  title           String
  description     String?
  periodType      String   // DAILY, WEEKLY, MONTHLY, QUARTERLY, ANNUAL
  startDate       DateTime
  endDate         DateTime
  // Administrative unit (at least one should be set)
  subCityId       String?
  subCity         SubCity? @relation(fields: [subCityId], references: [id])
  woredaId        String?
  woreda          Woreda?  @relation(fields: [woredaId], references: [id])
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id])
  // Responsible person
  responsibleStaffId String?
  responsible     Staff?   @relation("PlanResponsible", fields: [responsibleStaffId], references: [id])
  // Plan details
  activity        String   // planned activity description
  targetAmount    Float?   // ETB target (nullable for non-financial plans)
  targetQuantity  Int?     // e.g. number of taxpayers to visit
  expectedOutcome String?
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status          String   @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, OVERDUE, CANCELLED
  progress        Int      @default(0) // 0-100 percentage
  actualAmount    Float?   // ETB actually collected/achieved
  actualQuantity  Int?     // actual count achieved
  remarks         String?
  challenges      String?
  createdByStaffId String?
  createdBy       Staff?   @relation("PlanCreator", fields: [createdByStaffId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Notification — alerts for deadlines, overdue, low performance, plans, etc.
model Notification {
  id              String   @id @default(cuid())
  type            String   // DEADLINE_WARNING, OVERDUE, LOW_PERFORMANCE, PLAN_INCOMPLETE, PLAN_OVERDUE, TARGET_ASSIGNED, TARGET_ACHIEVED, ASSIGNMENT_CREATED, BANK_RECEIPT_RECEIVED, GOVT_RECEIPT_ISSUED, GENERAL
  title           String
  message         String
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  // Recipient: either specific staff OR broadcast to a role
  recipientStaffId String?
  recipient       Staff?   @relation("NotificationsReceived", fields: [recipientStaffId], references: [id])
  broadcastRole   String?  // if set, all staff with this role see it
  // Related entity (optional link)
  relatedType     String?  // ASSIGNMENT, PLAN, TARGET, TAXPAYER, STAFF
  relatedId       String?
  // Read tracking
  readAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([recipientStaffId])
  @@index([broadcastRole])
}
// Each row = "can role X perform action Y?"
// If no row exists for a (role, action) pair, the default from ACTIONS
// constant in src/lib/permissions.ts is used.
model Permission {
  id        String   @id @default(cuid())
  role      String   // LEADER, TEAM_1_ASSIGNMENT, TEAM_2_FINANCE, CITY_REVENUE_OFFICER, DATA_COLLECTOR, SYSTEM_ADMIN
  action    String   // e.g. ADD_TAXPAYER, BLOCK_TAXPAYER, CREATE_ASSIGNMENT, etc.
  allowed   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([role, action])
}

// ---- Tax payer registry ---------------------------------------------------

model TaxPayer {
  id                String   @id @default(cuid())
  tin               String   @unique // Tax Identification Number
  fullName          String
  category          String   // BUSINESS, PROPERTY, INDIVIDUAL_INCOME, VEHICLE, VAT, WITHHOLDING
  phone             String?
  email             String?
  address           String?
  woredaId          String?
  woreda           Woreda?  @relation(fields: [woredaId], references: [id])
  kebele            String?
  tradeLicenseNo    String?  // for businesses
  contactPerson     String?  // for businesses
  notes             String?
  active            Boolean  @default(true)
  // Block / suspension flag
  blocked           Boolean  @default(false)
  blockedReason     String?
  blockedAt         DateTime?
  blockedByStaffId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignments TaxAssignment[]
}

// ---- A tax assignment = one tax obligation for one period ---------------

model TaxAssignment {
  id            String   @id @default(cuid())
  referenceNo   String   @unique // e.g. BF-2026-0001
  taxPayerId    String
  taxPayer      TaxPayer @relation(fields: [taxPayerId], references: [id])

  fiscalYear    String   // e.g. "2025/2026"
  period        String   // Q1, Q2, Q3, Q4, ANNUAL, MONTHLY-2026-01...
  taxType       String   // Business Tax, Property Tax, Income Tax, VAT, etc.
  description   String?
  amountDue     Float    // ETB
  dueDate       DateTime?

  // Workflow status:
  //   ASSIGNED -> BANK_RECEIPT_SUBMITTED -> VERIFIED -> COMPLETED (or CANCELLED)
  status        String   @default("ASSIGNED")

  // Team 1 - Assignment
  assignedByStaffId String?
  assignedBy        Staff? @relation("StaffAssignedTo", fields: [assignedByStaffId], references: [id])
  assignedByName    String  // denormalized for safety (in case staff is deleted)
  assignedAt        DateTime @default(now())

  // Team 2 - Bank receipt (received from tax payer after they paid at the bank)
  bankName              String?
  bankReceiptNumber     String?
  paymentDate           DateTime?
  paymentAmount         Float?
  bankReceiptNote       String?
  bankReceiptReceivedByStaffId String?
  bankReceiptReceivedBy         Staff? @relation("StaffBankReceiptReceiver", fields: [bankReceiptReceivedByStaffId], references: [id])
  bankReceiptReceivedByName     String?
  bankReceiptReceivedAt         DateTime?

  // Team 2 - Government receipt (final confirmation to tax payer)
  governmentReceiptNumber      String?
  governmentReceiptIssuedByStaffId String?
  governmentReceiptIssuedBy             Staff? @relation("StaffGovtReceiptIssuer", fields: [governmentReceiptIssuedByStaffId], references: [id])
  governmentReceiptIssuedByName         String?
  governmentReceiptIssuedAt              DateTime?
  governmentReceiptNote                 String?

  // Dispute / under review flag
  disputed       Boolean  @default(false)
  disputeReason  String?
  disputedAt     DateTime?
  disputedByStaffId String?

  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  history       AssignmentHistory[]
  attachments   BankReceiptAttachment[]
}

// Uploaded bank receipt images/PDFs stored as base64 in Postgres
model BankReceiptAttachment {
  id            String   @id @default(cuid())
  assignmentId  String
  assignment    TaxAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  fileSize      Int      // bytes
  content       String   // base64-encoded file content
  uploadedByStaffId String?
  uploadedAt    DateTime @default(now())
}

// Audit trail / timeline of every status change
model AssignmentHistory {
  id            String   @id @default(cuid())
  assignmentId  String
  assignment    TaxAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  action        String   // ASSIGN, BANK_RECEIPT_RECEIVED, VERIFY, ISSUE_GOVERNMENT_RECEIPT, CANCEL, EDIT, DISPUTE, UNDISPUTE, BLOCK, UNBLOCK
  fromStatus    String?
  toStatus      String?
  performedByStaffId String?
  performedBy         Staff? @relation(fields: [performedByStaffId], references: [id])
  performedByName    String
  note          String?
  timestamp     DateTime @default(now())
}

// Yearly tax target (expected tax) per woreda + category, set by Leader / City Admin
// Used by the City Income dashboard to compare expected vs collected.
// woredaId is nullable: a null woredaId = city-wide target for that category.
model YearlyTaxTarget {
  id              String   @id @default(cuid())
  fiscalYear      String   // e.g. "2026/2027"
  woredaId        String?  // null = city-wide target for this category
  woreda          Woreda?  @relation(fields: [woredaId], references: [id])
  category        String   // BUSINESS, PROPERTY, INDIVIDUAL_INCOME, VEHICLE, VAT, WITHHOLDING
  expectedAmount  Float    // ETB - the target the city expects to collect
  notes           String?
  setByStaffId    String?
  setBy           Staff?   @relation(fields: [setByStaffId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([fiscalYear, woredaId, category])
}
