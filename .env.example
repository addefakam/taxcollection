# Bishoftu Finance — Tax Collection System
# Copy this file to .env and fill in your real values.

# Neon PostgreSQL connection string.
# Get it from your Neon dashboard: https://console.neon.tech
#  1. Create a project (free tier is fine).
#  2. Click "Connect" or "Dashboard" -> "Connection string".
#  3. Pick the "Pooled connection" (recommended for serverless / Next.js).
#  4. Copy the whole string here, including the ?sslmode=require part.
#
# Format:
#   postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
#
# Example:
#   DATABASE_URL="postgresql://neondb_owner:npg_xxx@ep-cool-name-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional: a direct (non-pooled) URL used only for migrations.
# Useful if Neon's pooler is unavailable for DDL. Leave blank to use DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Secret key used to sign session JWTs (httpOnly cookies).
# Generate a strong random string of at least 32 characters, e.g.:
#   openssl rand -base64 48
# Or use any long random string. NEVER commit the real value to git.
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-characters-long"
